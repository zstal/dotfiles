[init]
	defaultBranch = main

[log]
	date = iso

[core]
	excludesfile = ~/.gitignore_global
	pager = delta

[push]
	autoSetupRemote = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[include]
	path = ~/.gituser

[delta]
	line-numbers = true
	navigate = true
	side-by-side = true
